{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./registry.schema.json",
  "title": "S1933 skills registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "version",
    "generated_at",
    "count",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "skills": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "owner",
          "repo",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "discovery",
              "design",
              "implementation",
              "quality",
              "delivery",
              "style",
              "setup"
            ]
          }
        }
      }
    }
  }
}